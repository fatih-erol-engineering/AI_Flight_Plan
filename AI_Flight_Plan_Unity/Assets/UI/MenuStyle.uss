.hidden {
    display: none;
}

.section {
    row-gap: 6px;
}

.primary {
    width: 100%;
    background-color: rgb(37, 99, 235);
    color: white;
    border-radius: 8px;
}

.title {
    font-size: 20px;
    color: rgb(37, 99, 235);
    margin-bottom: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.DropDown {
    background-color: rgb(255, 255, 255);
}

.FloatInput {
    flex-shrink: 0;
    opacity: 1;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
}

Label {
}

.button:hover {
    scale: 1.1 1.1 1.1;
    background-color: var(--themeColor);
    opacity: 1;
}

.button {
    background-color: var(--themeColor);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: auto;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: auto;
    align-content: auto;
    justify-content: flex-start;
    align-items: auto;
    flex-direction: column;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    opacity: 0.8;
}

.button:active {
    background-color: var(--activeColor);
    scale: 1 1;
}

:root {
    --themeColor: rgb(38, 128, 255);
    --backgroundColor: rgb(255, 255, 255);
    --activeColor: rgb(255, 128, 38);
}
