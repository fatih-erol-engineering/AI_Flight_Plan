.ctx-root {
    position: absolute;
    width: 220px;
    background-color: white;
    border: 1px solid rgb(226, 232, 240);
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    display: none;
    height: 98px;
    align-content: stretch;
    align-self: auto;
    justify-content: flex-start;
    flex-direction: column;
}

.hidden {
    display: none;
}

.section {
    row-gap: 6px;
}

.btn {
    width: auto;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    justify-content: flex-start;
    align-self: stretch;
}

.primary {
    width: 100%;
    background-color: rgb(37, 99, 235);
    color: white;
    border-radius: 8px;
}

.title {
    font-size: 20px;
    color: rgb(37, 99, 235);
    margin-bottom: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.FloatInput {
    -unity-text-align: upper-right;
    left: auto;
    align-items: stretch;
    justify-content: flex-start;
    align-self: stretch;
    width: auto;
    min-width: auto;
    max-width: none;
    padding-left: 0;
    margin-left: -45px;
    margin-bottom: 5px;
    margin-top: 5px;
}

.DropDown {
    background-color: rgb(255, 255, 255);
}

#unity-dragger {
    width: 30px;
    height: 70px;
    align-self: auto;
    justify-content: center;
    align-items: center;
    align-content: center;
    top: -10px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}
