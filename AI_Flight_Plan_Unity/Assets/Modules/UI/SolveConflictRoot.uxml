<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/UI/Styles/MenuStyle.uss?fileID=7433441132597879392&amp;guid=bdb532c554170404fa758dffbbdb0d62&amp;type=3#MenuStyle" />
    <Style src="project://database/Assets/Modules/UI/Styles/PopupStyle.uss?fileID=7433441132597879392&amp;guid=4c80e6cc20e914447b6b4a07c3d0ddb7&amp;type=3#PopupStyle" />
    <ui:VisualElement name="aircraftConflictRoot" style="flex-grow: 1; margin-right: 10px;">
        <ui:Foldout text="Vehicle - 1" toggle-on-label-click="true" value="true" name="aircraftConflictFoldout">
            <ui:VisualElement style="flex-direction: row; justify-content: space-evenly; align-items: stretch; align-self: stretch; align-content: auto;">
                <ui:Label text="Time Change" style="width: 100px;" />
                <ui:Slider value="4" high-value="1" fill="true" name="timeOrPositionChangeVal" style="width: 150px;" />
                <ui:Label text="Position Change" style="width: 100px; -unity-text-align: upper-left;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-evenly; align-items: stretch; align-self: stretch; align-content: center;">
                <ui:Label text="Non- Editable" style="width: 100px;" />
                <ui:Slider value="4" high-value="1" fill="true" name="nonEditableOrEditableVal" style="width: 150px; flex-direction: column; align-self: center;" />
                <ui:Label text="Editable" style="width: 100px; -unity-text-align: upper-left;" />
            </ui:VisualElement>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
