:root {
    --colorTheme: rgb(113, 12, 4);
    --colorPassive: rgb(0, 0, 0);
    --colorActive: rgb(82, 9, 3);
    --colorText: rgb(255, 255, 255);
    --colorIcon: rgb(255, 255, 255);
    --sizeTextButton: 16;
}

.button {
    width: 60px;
    height: 60px;
    opacity: 0.5;
    background-color: var(--colorPassive);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    overflow: visible;
    margin-right: 2px;
    margin-left: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    transition-duration: 0.25s;
}

.button:hover {
    width: 60px;
    height: 60px;
    opacity: 0.5;
    background-color: var(--colorTheme);
    scale: 1.05 1.05 1.05;
    transition-duration: 0.25s;
}

.button:checked {
    width: 60px;
    height: 60px;
    opacity: 1;
    background-color: var(--colorTheme);
    scale: 1.05 1.05 1.05;
    transition-duration: 0.25s;
}

.buttonStart {
    width: 60px;
    height: 60px;
    opacity: 0.5;
    background-color: var(--colorPassive);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    overflow: visible;
    margin-right: 2px;
    margin-left: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.buttonEnd {
    width: 60px;
    height: 60px;
    opacity: 0.5;
    background-color: var(--colorPassive);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    overflow: visible;
    margin-right: 2px;
    margin-left: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.dropDown {
    background-color: var(--colorTheme);
    opacity: 1;
    width: 120px;
    border-bottom-right-radius: 20px;
    border-top-left-radius: 20px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
}

.dropDown:hover {
    background-color: var(--colorTheme);
    opacity: 1;
}

.unity-popup-field__input {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.unity-base-popup-field__text {
    color: var(--colorText);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--colorIcon);
}

.submenus {
    display: flex;
    transition-duration: 0.25s;
}

.submenusHidden {
    display: none;
    translate: 219px 0;
    opacity: 0;
    transition-duration: 0.25s;
}

.unity-toggle {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    transition-duration: 0.25s;
}

.unity-toggle > .unity-toggle__input > #unity-checkmark {
    background-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-size: 55% 55%;
    opacity: 0.5;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-top-left-radius: 0;
    border-bottom-right-radius: 0;
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    transition-duration: 0.25s;
}

.unity-toggle:hover > .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Add.png?fileID=2800000&guid=20a73c4cbbc9a784cafac7bc4a13f0a7&type=3#Add");
    background-color: var(--colorTheme);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 0.4;
    transition-duration: 0.25s;
}

.unity-toggle:active .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Add.png?fileID=2800000&guid=20a73c4cbbc9a784cafac7bc4a13f0a7&type=3#Add");
    background-color: var(--colorTheme);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 0.4;
    scale: 0.95 0.95 0.95;
    transition-duration: 0.25s;
}

.unity-toggle:checked .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Add.png?fileID=2800000&guid=20a73c4cbbc9a784cafac7bc4a13f0a7&type=3#Add");
    background-color: var(--colorTheme);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
    transition-duration: 0.25s;
}

#createTBtn .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Add.png?fileID=2800000&guid=20a73c4cbbc9a784cafac7bc4a13f0a7&type=3#Add");
}

#listenTBtn .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Listen.png?fileID=2800000&guid=df64452fdc7d6954eb9eb7d5dc2ddfc0&type=3#Listen");
}

#settingsTBtn .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Settings.png?fileID=2800000&guid=44d100d5cff7b214aba1823b09cb11b8&type=3#Settings");
}

.unity-toggle_start {
    border-bottom-right-radius: 0;
}

.unity-toggle_start > .unity-toggle__input > #unity-checkmark {
    border-bottom-right-radius: 0;
    border-top-left-radius: 40px;
    border-bottom-left-radius: 0;
}

.unity-toggle_end {
    border-bottom-right-radius: 0;
}

.unity-toggle_end > .unity-toggle__input > #unity-checkmark {
    border-bottom-right-radius: 40px;
    border-top-right-radius: 0;
}

#rotorTBtn .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/RotorType.png?fileID=2800000&guid=fdb3c61cb9365f846a06d2b7975338e2&type=3#RotorType");
}

#fixedWingTBtn .unity-toggle__input > #unity-checkmark {
    background-image: url("project://database/Assets/Icons/Fixed%20Wing%20Type.png?fileID=2800000&guid=8191d99e70fa840488e94e9dd44c897e&type=3#Fixed Wing Type");
}

.popup-root {
    width: 300px;
    padding: 8px;
    background-color: rgb(34, 34, 34);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    transition-duration: 0.25s;
    display: none;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.popup-root > .unity-text-field > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
}

.title {
    unity-font-style: bold;
    margin-bottom: 6px;
    font-size: 20px;
    -unity-text-align: upper-center;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.button_popup {
    width: auto;
    height: auto;
    opacity: 1;
    overflow: visible;
    margin-right: 2px;
    margin-left: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    align-items: auto;
    justify-content: flex-start;
    align-self: auto;
    align-content: auto;
    flex-grow: 1;
    background-color: var(--colorActive);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    visibility: visible;
}

.button_popup:hover {
    opacity: 1;
    background-color: var(--colorTheme);
    scale: 1.05 1.05 1.05;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.button_popup:active {
    opacity: 1;
    background-color: var(--colorTheme);
    scale: 1 1;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hidden {
}
